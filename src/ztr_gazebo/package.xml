<?xml version="1.0"?>
<package format="3">
  <name>ztr_gazebo</name>
  <version>0.1.0</version>
  <description>Zero to Robot workshop: race track world, launch files and car safety node (ROS 2 Humble, Gazebo Fortress).</description>
  <maintainer email="194249571+Kumar003-gak@users.noreply.github.com">Kumar003-gak</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ztr_description</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
